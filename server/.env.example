# ── Environment ──────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smriti
DB_USER=postgres
DB_PASSWORD=your_password_here

# Express server
PORT=3001

# Environment
NODE_ENV=development

# Memora — Web Development Environment
#
# VITE_API_BASE_URL
#   Leave blank (default) for web dev — Vite proxy routes /api → localhost:3001
#   Set to http://10.0.2.2:3001 for Android Emulator
#   Set to http://<YOUR-LAN-IP>:3001 for physical Android device
#   Set to https://your-backend.example.com for production
#
# VITE_API_BASE_URL=

# Uncomment for Android Emulator testing:
# VITE_API_BASE_URL=http://10.0.2.2:3001

# Uncomment for physical device (replace with your machine's LAN IP):
# VITE_API_BASE_URL=http://192.168.1.x:3001
